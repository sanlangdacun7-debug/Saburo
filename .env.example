# Anthropic の API キー（https://console.anthropic.com/ で発行）
ANTHROPIC_API_KEY=sk-ant-...

# Web画面のログインパスワード（必ず変更。外出先から使うなら12文字以上）
SABURO_PASSWORD=change-me

# あなたの呼び名（AIがこの名前で呼びかけます）
SABURO_OWNER_NAME=オーナー

# 考える深さ: low / medium / high / xhigh / max（高いほど賢いが遅く高い）
SABURO_EFFORT=medium

# --- 外出先から使う（python -m saburo.remote）---
# 名前付きトンネルを使うときだけ設定（空ならクイックトンネル）
# SABURO_TUNNEL_TOKEN=eyJ...
# SABURO_PUBLIC_URL=https://saburo.example.com
